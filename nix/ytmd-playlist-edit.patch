+// RemovePlaylistSong resolves the editable entry in the current playlist
+// before submitting the mutation. A video ID alone cannot identify an entry.
+func (c *Client) RemovePlaylistSong(ctx context.Context, id, songID string) error {
+	id = strings.TrimPrefix(id, "VL")
+	if id == "" || id == catalog.LikedID || songID == "" {
+		return catalog.ErrNotFound
+	}
+	c.load()
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	resp, err := browse(ctx, c.signedCall, "playlist", id, map[string]any{"browseId": "VL" + id})
+	if err != nil {
+		return err
+	}
+	_, rows, ok := playlistPage(id, resp)
+	if !ok {
+		return catalog.ErrNotFound
+	}
+	seen := map[string]bool{}
+	for visited := 0; visited < maxPlaylistSongs; {
+		for _, row := range rows {
+			if row.ListItem == nil {
+				continue
+			}
+			for _, item := range row.ListItem.Menu.Renderer.Items {
+				for _, action := range item.Service.Endpoint.Edit.Actions {
+					if action.VideoID != songID || action.SetVideoID == "" {
+						continue
+					}
+					reply, err := c.signedCall(ctx, "browse/edit_playlist", map[string]any{
+						"playlistId": id,
+						"actions": []map[string]string{{
+							"action":         "ACTION_REMOVE_VIDEO",
+							"removedVideoId": songID,
+							"setVideoId":     action.SetVideoID,
+						}},
+					})
+					if err != nil {
+						return err
+					}
+					if reply.Status != "STATUS_SUCCEEDED" {
+						return fmt.Errorf("youtube music did not confirm the playlist edit")
+					}
+					return nil
+				}
+			}
+		}
+		token := continuation(rows)
+		if token == "" || seen[token] {
+			break
+		}
+		seen[token] = true
+		visited += max(1, len(rows))
+		next, err := c.signedCall(ctx, "browse", map[string]any{"continuation": token})
+		if err != nil {
+			return err
+		}
+		rows = continuationItems(next)
+	}
+	return catalog.ErrNotFound
+}
+
