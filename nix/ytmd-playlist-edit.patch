+// PlayOrdered restores an existing shuffled order and resumes the current song.
+func (p *Player) PlayOrdered(ids []string, start int, position float64) {
+	if len(ids) == 0 {
+		return
+	}
+	p.setQueue(ids, start)
+	p.isShuffled, p.isPlaying, p.position = true, true, 0
+	p.Seek(position)
+}
